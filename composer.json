{
    "name": "beelab/tag-bundle",
    "type": "symfony-bundle",
    "description": "Provide tags for Doctrine entities in Symfony",
    "keywords": [
        "Tag",
        "Tags",
        "Symfony"
    ],
    "homepage": "https://github.com/bee-lab/",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Massimiliano Arione",
            "email": "garakkio@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^2.7",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.3"
    },
    "config": {
        "bin-dir": "bin",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "autoload": {
        "psr-4": {
            "Beelab\\TagBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beelab\\TagBundle\\Tests\\": "tests/"
        }
    }

}
